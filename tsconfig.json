{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "isolatedModules": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "types": ["node"], "noUnusedLocals": false
  },
  "include": ["src", "tests", "vite.config.ts", "capacitor.config.ts"]
}
